# Copy to .env.local and fill in. Never commit .env.local — it is gitignored.

# Supabase project. Settings -> API Keys.
# Use the PUBLISHABLE / anon key (sb_publishable_… or the eyJ… anon JWT).
# NEVER the secret / service_role key: this variable is compiled into the
# JavaScript every visitor downloads, and the secret key bypasses row level
# security entirely.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Railway processing API.
NEXT_PUBLIC_API_URL=

# Set to 1 only once that API verifies Supabase JWTs. Off by default, because
# sending an Authorization header to an endpoint whose CORS policy does not
# list it would fail every request.
NEXT_PUBLIC_API_AUTH=0
